 */

/dts-v1/;

#include "k3-am62p5-var-som.dtsi"

/ {
	model = "Variscite VAR-SOM-AM62P on JIG";

	aliases {
		ethernet0 = &cpsw_port1;
		ethernet1 = &cpsw_port2;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
		mmc2 = &sdhci2;
		serial0 = &main_uart0;
		serial2 = &main_uart2;
		serial5 = &main_uart5;
		serial6 = &main_uart6;
		spi5 = &main_spi2;
		usb0 = &usb0;
		usb1 = &usb1;
		i2c0 = &main_i2c0;
		i2c1 = &main_i2c1;
		i2c2 = &main_i2c2;
		i2c3 = &main_i2c3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200n8 earlycon=ns16550a,mmio32,0x02800000";
	};

	clk_ov5640_fixed: clock {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
	};

	display {
		compatible = "sgd,gktw70sdae4se";
		status = "okay";

		port@0 {
			lcd_in0: endpoint {
				remote-endpoint = <&oldi0_dss0_out>;
			};
		};
	};

	display1 {
		compatible = "sgd,gktw70sdae4se";
		status = "okay";

		port@1 {
			lcd_in1: endpoint {
				remote-endpoint = <&oldi1_dss0_out>;
			};
		};
	};

	transceiver1: can-phy0 {
		compatible = "ti,tcan1042";
		#phy-cells = <0>;
		max-bitrate = <5000000>;
	};

	vdd_mmc1: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "sd_ext_rst";
	        vin-supply = <&vdd_mmc1_int>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pca9534 6 GPIO_ACTIVE_HIGH>;
		bootph-all;
	};

	vdd_mmc1_int: regulator-2 {
		compatible = "regulator-fixed";
		regulator-name = "sd_int_rst";
		pinctrl-names = "default";
		pinctrl-0 = <&vdd_mmc1_pins_default>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		enable-active-high;
		gpio = <&main_gpio0 53 GPIO_ACTIVE_HIGH>;
		bootph-all;
	};

	vdd_sd_dv: regulator-3 {
		compatible = "regulator-gpio";
		regulator-name = "vdd_sd_vio";
		pinctrl-names = "default";
		pinctrl-0 = <&vdd_sd_dv_pins_default>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		gpios = <&main_gpio0 56 GPIO_ACTIVE_HIGH>;
		states = <1800000 0x0>,
			 <3300000 0x1>;
		bootph-all;
	};

	vcc_3v3_main: regulator-4 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_main";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&cdns_csi2rx0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		csi0_port0: port@0 {
			reg = <0>;
			status = "okay";

			csi2rx0_in_sensor: endpoint {
				remote-endpoint = <&csi2_cam0>;
				bus-type = <4>; /* CSI2 DPHY. */
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
	};
};

&cpsw3g {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_rgmii1_pins_default>;
};

&cpsw3g_mdio {
	pinctrl-names = "default";
	pinctrl-0 = <&main_mdio1_pins_default>;

	cpsw3g_phy1: ethernet-phy@5 {
		status = "disabled";
		reg = <5>;
		compatible = "ethernet-phy-id0283.bc30";
		reset-gpios = <&pca9534 5 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <100000>;
	};
};

&cpsw_port2 {
	phy-mode = "rgmii";
	phy-handle = <&cpsw3g_phy1>;
	status = "okay";
};

&dphy0 {
	status = "okay";
};

&dss0 {
	status = "okay";
};

&dss0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	/* VP1: Output to OLDI */
	port@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		dss0_dpi0_out0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&oldi0_dss0_in>;
		};

		dss0_dpi0_out1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&oldi1_dss0_in>;
		};
	};
};

&epwm1 {
	status = "disabled";
};

&mailbox0_cluster0 {
	mbox_r5_0: mbox-r5-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};
};

&mailbox0_cluster1 {
	mbox_mcu_r5_0: mbox-mcu-r5-0 {
		ti,mbox-rx = <0 0 0>;
		ti,mbox-tx = <1 0 0>;
	};
};

&main_i2c0{
	status = "disabled";
};

&main_i2c1 {
	status = "disabled";
};

&main_i2c2 {
	ov5640: camera@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;

		clocks = <&clk_ov5640_fixed>;
		clock-names = "xclk";

		pinctrl-names = "default";

		port {
			csi2_cam0: endpoint {
				remote-endpoint = <&csi2rx0_in_sensor>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
	};

	/* GPIO expander */
	pca9534: gpio@20 {
		compatible = "nxp,pca9534";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};
};

&main_mcan0 {
	status = "disabled";
};

&main_pmx0 {

	pinctrl-names = "default";
	pinctrl-0 = <&mygpio1_pins_default>;

	mygpio1_pins_default: mygpio1-pins-default {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x01f0, PIN_INPUT, 7) /* (C25) EXT_REFCLK1.GPIO1_30 */
			AM62PX_IOPAD(0x0078, PIN_INPUT, 7) /* (AC24) GPMC0_AD15.GPIO0_30 */
			AM62PX_IOPAD(0x0164, PIN_INPUT, 7) /* (A20) RGMII2_TX_CTL.GPIO0_87 */
			AM62PX_IOPAD(0x0168, PIN_INPUT, 7) /* (D16) RGMII2_TXC.GPIO0_88 */
			AM62PX_IOPAD(0x016c, PIN_INPUT, 7) /* (B19) RGMII2_TD0.GPIO0_89 */
			AM62PX_IOPAD(0x0170, PIN_INPUT, 7) /* (A21) RGMII2_TD1.GPIO0_90 */
			AM62PX_IOPAD(0x0174, PIN_INPUT, 7) /* (D17) RGMII2_TD2.GPIO0_91 */
			AM62PX_IOPAD(0x0178, PIN_INPUT, 7) /* (A19) RGMII2_TD3.GPIO1_0 */
			AM62PX_IOPAD(0x017c, PIN_INPUT, 7) /* (F19) RGMII2_RX_CTL.GPIO1_1 */
			AM62PX_IOPAD(0x0180, PIN_INPUT, 7) /* (D19) RGMII2_RXC.GPIO1_2 */
			AM62PX_IOPAD(0x0184, PIN_INPUT, 7) /* (E19) RGMII2_RD0.GPIO1_3 */
			AM62PX_IOPAD(0x0188, PIN_INPUT, 7) /* (E16) RGMII2_RD1.GPIO1_4 */
			AM62PX_IOPAD(0x018c, PIN_INPUT, 7) /* (E17) RGMII2_RD2.GPIO1_5 */
			AM62PX_IOPAD(0x0190, PIN_INPUT, 7) /* (C19) RGMII2_RD3.GPIO1_6 */
			AM62PX_IOPAD(0x001c, PIN_INPUT, 7) /* (N21) OSPI0_D4.GPIO0_7 */
			AM62PX_IOPAD(0x0020, PIN_INPUT, 7) /* (N22) OSPI0_D5.GPIO0_8 */
			AM62PX_IOPAD(0x0024, PIN_INPUT, 7) /* (P21) OSPI0_D6.GPIO0_9 */
			AM62PX_IOPAD(0x0028, PIN_INPUT, 7) /* (N20) OSPI0_D7.GPIO0_10 */
			AM62PX_IOPAD(0x01e0, PIN_INPUT, 7) /* (B25) I2C0_SCL.GPIO1_26 */
			AM62PX_IOPAD(0x01e4, PIN_INPUT, 7) /* (A24) I2C0_SDA.GPIO1_27 */
			AM62PX_IOPAD(0x01e8, PIN_INPUT, 7) /* (C24) I2C1_SCL.GPIO1_28 */
			AM62PX_IOPAD(0x01ec, PIN_INPUT, 7) /* (B24) I2C1_SDA.GPIO1_29 */
			AM62PX_IOPAD(0x01ac, PIN_INPUT, 7) /* (G23) MCASP0_AFSR.GPIO1_13 */
			AM62PX_IOPAD(0x0244, PIN_INPUT, 7) /* (D24) MMC1_SDWP.GPIO1_49 */
			AM62PX_IOPAD(0x0194, PIN_INPUT, 7) /* (D25) MCASP0_AXR3.GPIO1_7 */
			AM62PX_IOPAD(0x0198, PIN_INPUT, 7) /* (E25) MCASP0_AXR2.GPIO1_8 */
			AM62PX_IOPAD(0x019c, PIN_INPUT, 7) /* (E24) MCASP0_AXR1.GPIO1_9 */
			AM62PX_IOPAD(0x01a0, PIN_INPUT, 7) /* (F23) MCASP0_AXR0.GPIO1_10 */
			AM62PX_IOPAD(0x01a4, PIN_INPUT, 7) /* (F24) MCASP0_ACLKX.GPIO1_11 */
			AM62PX_IOPAD(0x01a8, PIN_INPUT, 7) /* (F25) MCASP0_AFSX.GPIO1_12 */
			AM62PX_IOPAD(0x01b0, PIN_INPUT, 7) /* (G20) MCASP0_ACLKR.GPIO1_14 */
			AM62PX_IOPAD(0x01b8, PIN_INPUT, 7) /* (E20) SPI0_CS1.GPIO1_16 */
			AM62PX_IOPAD(0x01d8, PIN_INPUT, 7) /* (B23) MCAN0_TX.GPIO1_24 */
			AM62PX_IOPAD(0x01dc, PIN_INPUT, 7) /* (F20) MCAN0_RX.GPIO1_25 */
			AM62PX_IOPAD(0x240, PIN_INPUT, 7) /* (D23) MMC1_SDCD.GPIO1_48 */
			AM62PX_IOPAD(0x0048, PIN_INPUT, 7) /* (V25) GPMC0_AD3.GPIO0_18 */
			AM62PX_IOPAD(0x004c, PIN_INPUT, 7) /* (T20) GPMC0_AD4.GPIO0_19 */
			AM62PX_IOPAD(0x0050, PIN_INPUT, 7) /* (T21) GPMC0_AD5.GPIO0_20 */
			AM62PX_IOPAD(0x0054, PIN_INPUT, 7) /* (V24) GPMC0_AD6.GPIO0_21 */
			AM62PX_IOPAD(0x0058, PIN_INPUT, 7) /* (W25) GPMC0_AD7.GPIO0_22 */
			AM62PX_IOPAD(0x005c, PIN_INPUT, 7) /* (AC25) GPMC0_AD8.GPIO0_23 */
			AM62PX_IOPAD(0x0060, PIN_INPUT, 7) /* (AB25) GPMC0_AD9.GPIO0_24 */
			AM62PX_IOPAD(0x0064, PIN_INPUT, 7) /* (AA25) GPMC0_AD10.GPIO0_25 */
			AM62PX_IOPAD(0x0068, PIN_INPUT, 7) /* (W24) GPMC0_AD11.GPIO0_26 */
			AM62PX_IOPAD(0x006c, PIN_INPUT, 7) /* (Y24) GPMC0_AD12.GPIO0_27 */
			AM62PX_IOPAD(0x0070, PIN_INPUT, 7) /* (AD25) GPMC0_AD13.GPIO0_28 */
			AM62PX_IOPAD(0x0074, PIN_INPUT, 7) /* (AB24) GPMC0_AD14.GPIO0_29 */
			AM62PX_IOPAD(0x009c, PIN_INPUT, 7) /* (AD24) GPMC0_WAIT1.GPIO0_38 */
			AM62PX_IOPAD(0x0254, PIN_INPUT, 7) /* (G22) USB0_DRVVBUS.GPIO1_50 */
			AM62PX_IOPAD(0x0258, PIN_INPUT, 7) /* (G21) USB1_DRVVBUS.GPIO1_51 */
		>;
	};

	main_mmc1_pins_default: main-mmc1-pins-default {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x023c, PIN_INPUT, 0) /* (H20) MMC1_CMD */
			AM62PX_IOPAD(0x0234, PIN_OUTPUT, 0) /* (J24) MMC1_CLK */
			AM62PX_IOPAD(0x0230, PIN_INPUT, 0) /* (H21) MMC1_DAT0 */
			AM62PX_IOPAD(0x022c, PIN_INPUT_PULLUP, 0) /* (H23) MMC1_DAT1 */
			AM62PX_IOPAD(0x0228, PIN_INPUT_PULLUP, 0) /* (H22) MMC1_DAT2 */
			AM62PX_IOPAD(0x0224, PIN_INPUT_PULLUP, 0) /* (H25) MMC1_DAT3 */
		>;
		bootph-all;
	};

	main_uart0_pins_default: main-uart0-default-pins {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x1c8, PIN_INPUT, 0)	/* (A22) UART0_RXD */
			AM62PX_IOPAD(0x1cc, PIN_OUTPUT, 0)	/* (B22) UART0_TXD */
		>;
		bootph-all;
	};

	vdd_mmc1_pins_default: vdd-mmc1-pins-default {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x00d8, PIN_OUTPUT, 7) /* (AE22) VOUT0_DATA8.GPIO0_53 */
		>;
		bootph-all;
	};

	vdd_sd_dv_pins_default: vdd-sd-dv-pins-default {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x00e4, PIN_OUTPUT, 7) /* (AE21) VOUT0_DATA11.GPIO0_56 */
		>;
		bootph-all;
	};
};

&main_spi2 {
	status = "disabled";
};

&main_uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_uart0_pins_default>;
};

&main_uart1 {
	/* Main UART1 is used by TIFS firmware */
	status = "reserved";
};

&main_uart2 {
	status = "disabled";
};

&main_uart6 {
	status = "disabled";
};

&mcu_pmx0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mymcugpio1_pins_default>;

	mymcugpio1_pins_default: mymcugpio1-pins-default {
		pinctrl-single,pins = <
			AM62PX_MCU_IOPAD(0x0004, PIN_INPUT, 7) /* (E10) MCU_SPI0_CS1.MCU_GPIO0_1 */
			AM62PX_MCU_IOPAD(0x0008, PIN_INPUT, 7) /* (C10) MCU_SPI0_CLK.MCU_GPIO0_2 */
			AM62PX_MCU_IOPAD(0x000c, PIN_INPUT, 7) /* (B11) MCU_SPI0_D0.MCU_GPIO0_3 */
			AM62PX_MCU_IOPAD(0x0010, PIN_INPUT, 7) /* (D10) MCU_SPI0_D1.MCU_GPIO0_4 */
			AM62PX_MCU_IOPAD(0x0014, PIN_INPUT, 7) /* (B6) MCU_UART0_RXD.MCU_GPIO0_5 */
			AM62PX_MCU_IOPAD(0x0018, PIN_INPUT, 7) /* (C8) MCU_UART0_TXD.MCU_GPIO0_6 */
			AM62PX_MCU_IOPAD(0x001c, PIN_INPUT, 7) /* (B8) MCU_UART0_CTSn.MCU_GPIO0_7 */
			AM62PX_MCU_IOPAD(0x0020, PIN_INPUT, 7) /* (B7) MCU_UART0_RTSn.MCU_GPIO0_8 */
			AM62PX_MCU_IOPAD(0x0024, PIN_INPUT, 7) /* (D8) WKUP_UART0_RXD.MCU_GPIO0_9 */
			AM62PX_MCU_IOPAD(0x0028, PIN_INPUT, 7) /* (D7) WKUP_UART0_TXD.MCU_GPIO0_10 */
			AM62PX_MCU_IOPAD(0x002c, PIN_INPUT, 7) /* (C7) WKUP_UART0_CTSn.MCU_GPIO0_11 */
			AM62PX_MCU_IOPAD(0x0030, PIN_INPUT, 7) /* (C6) WKUP_UART0_RTSn.MCU_GPIO0_12 */
			AM62PX_MCU_IOPAD(0x0034, PIN_INPUT, 7) /* (E8) MCU_MCAN0_TX.MCU_GPIO0_13 */
			AM62PX_MCU_IOPAD(0x0038, PIN_INPUT, 7) /* (D6) MCU_MCAN0_RX.MCU_GPIO0_14 */
			AM62PX_MCU_IOPAD(0x003c, PIN_INPUT, 7) /* (F8) MCU_MCAN1_TX.MCU_GPIO0_15 */
			AM62PX_MCU_IOPAD(0x0040, PIN_INPUT, 7) /* (E7) MCU_MCAN1_RX.MCU_GPIO0_16 */
			AM62PX_MCU_IOPAD(0x0044, PIN_INPUT, 7) /* (E11) MCU_I2C0_SCL.MCU_GPIO0_17 */
			AM62PX_MCU_IOPAD(0x0048, PIN_INPUT, 7) /* (D11) MCU_I2C0_SDA.MCU_GPIO0_18 */
			AM62PX_MCU_IOPAD(0x005c, PIN_INPUT, 7) /* (F14) MCU_RESETSTATz.MCU_GPIO0_21 */
		>;
	};

	wkup_i2c0_pins_default: wkup-i2c0-default-pins {
		pinctrl-single,pins = <
			AM62PX_MCU_IOPAD(0x04c, PIN_INPUT, 0) /* (A13) WKUP_I2C0_SCL */
			AM62PX_MCU_IOPAD(0x050, PIN_INPUT, 0) /* (C11) WKUP_I2C0_SDA */
		>;
	};

	pmic_irq_pins_default: pmic-irq-default-pins {
		pinctrl-single,pins = <
			AM62PX_MCU_IOPAD(0x000, PIN_INPUT, 7) /* (B10) MCU_GPIO0_0 */
		>;
	};
};

&mcu_r5fss0 {
	status = "okay";
};

&mcu_r5fss0_core0 {
	mboxes = <&mailbox0_cluster1 &mbox_mcu_r5_0>;
	memory-region = <&mcu_r5fss0_core0_dma_memory_region>,
			<&mcu_r5fss0_core0_memory_region>;
};

&oldi0_dss0 {
	status = "okay";
};

&oldi0_dss0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;

		oldi0_dss0_in: endpoint {
			remote-endpoint = <&dss0_dpi0_out0>;
		};
	};

	port@1 {
		reg = <1>;

		oldi0_dss0_out: endpoint {
			remote-endpoint = <&lcd_in0>;
		};
	};
};

&oldi1_dss0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	port@0 {
		reg = <0>;

		oldi1_dss0_in: endpoint {
			remote-endpoint = <&dss0_dpi0_out1>;
		};
	};

	port@1 {
		reg = <1>;

		oldi1_dss0_out: endpoint {
			remote-endpoint = <&lcd_in1>;
		};
	};
};

&sdhci1 {
	/* SD Card */
	vmmc-supply = <&vdd_mmc1>;
	vqmmc-supply = <&vdd_sd_dv>;
	pinctrl-names = "default";
	pinctrl-0 = <&main_mmc1_pins_default>;
	disable-wp;
	non-removable;
	ti,fails-without-test-cd;
	status="okay";
	bootph-all;
};

&ti_csi2rx0 {
	status = "okay";
};

&usb0 {
	dr_mode = "peripheral";
	status="okay";
};

&usb1 {
	dr_mode = "host";
	status="okay";
};

&usbss0 {
	status = "okay";
};

&usbss1 {
	status = "okay";
};

&wkup_r5fss0 {
	status = "okay";
};

&wkup_r5fss0_core0 {
	mboxes = <&mailbox0_cluster0 &mbox_r5_0>;
	memory-region = <&wkup_r5fss0_core0_dma_memory_region>,
			<&wkup_r5fss0_core0_memory_region>;
};

&wkup_rtc0 {
	status = "disabled";
};

&wkup_rti0 {
	/* WKUP RTI0 is used by DM firmware */
	status = "reserved";
};

&wkup_uart0 {
	/* WKUP UART0 is used by DM firmware */
	status = "reserved";
	bootph-all;
};

&wkup_i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&wkup_i2c0_pins_default>;
	clock-frequency = <400000>;

	tps65224: pmic@48 {
		compatible = "ti,tps65224-q1";
		reg = <0x48>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq_pins_default>;
		interrupt-parent = <&mcu_gpio0>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
		ti,primary-pmic;

		gpio-controller;
		#gpio-cells = <2>;

		buck12-supply = <&vcc_3v3_main>;
		buck3-supply = <&vcc_3v3_main>;
		buck4-supply = <&vcc_3v3_main>;

		ldo1-supply = <&vcc_3v3_main>;
		ldo2-supply = <&vcc_3v3_main>;
		ldo3-supply = <&buck3>;

		regulators {
			buck12: buck12 {
				regulator-name = "vcc_core_buck12";
				regulator-min-microvolt = <715000>;
				regulator-max-microvolt = <895000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck3: buck3 {
				regulator-name = "vcc1v8_sys_buck3";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck4: buck4 {
				regulator-name = "vcc1v1_buck4";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: ldo1 {
				regulator-name = "vdda1v8_ldo1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2: ldo2 {
				regulator-name = "dvdd3v3_ldo2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3: ldo3 {
				regulator-name = "vcc_0v85_ldo3";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

/* mcu_gpio0 and mcu_gpio_intr are reserved for mcu firmware usage */
&mcu_gpio0 {
	status = "okay";
};

&mcu_gpio_intr {
	status = "okay";
};